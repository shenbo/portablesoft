{
    "version": "4.1.2",
    "description": "MinerU: A high-quality tool for convert PDF to Markdown and JSON.",
    "homepage": "https://github.com/opendatalab/MinerU",
    "url": "https://github.com/opendatalab/MinerU/releases/download/mineru-4.1.2-released/mineru-4.1.2-py3-none-any.whl",
    "notes": [
        "https://github.com/opendatalab/MinerU ",
        "- usage webui: ",
        "$ mineru-kit webui ",
        "",
        "- usage command: ",
        "$ mineru-kit parse document.pdf -o document.md -p 1-10 --tier standard ",
        "",
        "- usage command help: ",
        "$ mineru-kit parse --help",
        "*    inputs            <str> ",
        "*    --outputs   -o    <str>     [required] ",
        "-    --pages     -p    <str>     pages: '1-5,8'、'r3-r1'(reverse) or 'all' [default:all] ",
        "-    --format    -f    <str>     oputput fomate: markdown、middle_json、zip [default: markdown] ",
        "-    --verbose   -v              detail log info [default: False] ",
        "-    --tier            <str>     level: flash、basic、standard、advanced ",
        "-    --remote                    use mineru.net reomote service ",
        "-    --remote-url      <str>     reomote service URL ",
        "-    --api-key         <str>     reomote service API key ",
        "-    --ocr-mode        <str>     OCR mode: auto、txt、ocr [default: auto] ",
        "-    --disable-image-analysis    disable image analysis [default: False] "
    ],
    "installer": {
        "script": [
            "Write-Host \"`n*** create Python venv by uv ... \" -Foreground Blue ",
            "uv venv --python=3.13 \"$dir\\.venv\" ",
            "Write-Host \"*** activate venv ... \" -Foreground Blue ",
            "Invoke-Expression -Command \"$dir\\.venv\\Scripts\\activate.ps1\" ",
            "Write-Host \"*** uv pip install MinerU ... \" -Foreground Blue",
            "uv pip install mineru[torch] -i https://pypi.mirrors.ustc.edu.cn/simple ",
            "Write-Host \"*** mineru-kit ... \" -Foreground Blue "
        ]
    },
    "bin": ".venv\\Scripts\\mineru-kit.exe",
    "shortcuts": [
        [
            ".venv\\Scripts\\mineru-kit.exe",
            "mineru-kit"
        ]
    ],
    "hash": "d0cf1ac0dc90766d59833f47c9852d6a732a4ce106cf16931a62a5d55067c6cf",
    "checkver": {
        "url": "https://api.github.com/repos/opendatalab/MinerU/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "mineru-(?<version>[\\d.]+)-released"
    },
    "autoupdate": {
        "url": "https://github.com/opendatalab/MinerU/releases/download/mineru-$version-released/mineru-$version-py3-none-any.whl"
    }
}
