        ]
    },
    "notes": [
        "Register 'm3u8dl://' Url Protocol, ",
        " - https://github.com/xifangczy/URLProtocol"
    ],
    "installer": {
        "script": [
            "$sendToDir = [Environment]::GetFolderPath('SendTo')",
            "Write-Host \"*** SendTo directory: $sendToDir\" -Foreground Blue",
            "$batPath = Join-Path $sendToDir \"n_m3u8dl‑re.bat\"",
            "Write-Host \"*** Creating SendTo shortcut: $batPath\" -Foreground Blue",
            "$batContent = $dir + '\\n_m3u8dl-re.exe \"%1\" --save-name \"%~n1\"'",
            "Write-Host \"*** Writing $batContent to SendTo ... \" -Foreground Blue",
            "Set-Content -Path $batPath -Value $batContent -Encoding Default"
        ]
    },
    "url": "https://github.com/nilaoda/N_m3u8DL-RE/releases/download/v0.6.0-beta/N_m3u8DL-RE_v0.6.0-beta_win-x64_20260629.zip",
    "hash": "",
    "bin": "N_m3u8DL-RE.exe",
    "shortcuts": [
        [
            "N_m3u8DL-RE.exe",
            "N_m3u8DL_RE"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/nilaoda/N_m3u8DL-RE/releases",
        "regex": "releases/download/(?<tag>[vV]?[\\w-.]+)/N_m3u8DL-RE_([vV]?[\\w-.]+)_win-x64_(?<date>[\\d.-]+).zip",
        "replace": "${tag}"
